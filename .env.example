# BytePlus ModelArk (required for generation)
MODELARK_API_KEY=your_modelark_api_key
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MAIN_AGENT_ENDPOINT=your_endpoint_id
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=120000

# Search provider: auto, tavily, serper, brave, google, openalex, or duckduckgo
# "auto" uses Google through a local browser when no API key is configured.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional. Auto-detected on common macOS/Linux paths.
GOOGLE_CHROME_PATH=

# Optional application settings
APP_ENV=development
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=1800
WEBPAGE_TIMEOUT_SECONDS=1800
SEARCH_TIMEOUT_SECONDS=15
SEARCH_RESULTS_PER_QUERY=4
RULES_CACHE_HOURS=24
RULES_CACHE_PATH=app/data/cache/debate_rules.json

# Local temporary SQLite storage
ENABLE_LOCAL_HISTORY=true
DATABASE_PATH=app/data/debate_buddy.db
DATA_RETENTION_DAYS=360
DATABASE_CLEANUP_INTERVAL_HOURS=24
